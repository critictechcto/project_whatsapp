# Copy to .env (repo root) and fill in. Never commit real values.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database / cache (matches infra/docker/compose.dev.yml)
DATABASE_URL=postgres://upchatz:upchatz@localhost:5433/upchatz
REDIS_URL=redis://localhost:6379/0

# Meta / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v24.0
META_WEBHOOK_VERIFY_TOKEN=
# Dotted path of the Graph client; the fake is handy for local UI work without Meta.
WHATSAPP_GRAPH_CLIENT=apps.whatsapp.client.graph.HttpGraphClient

# Fernet keys for stored customer tokens, comma-separated. The first key encrypts; all decrypt.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# Billing (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Error tracking
SENTRY_DSN=
