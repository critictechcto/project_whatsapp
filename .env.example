# Copy to .env (repo root) and fill in. Never commit real values.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database / cache (matches infra/docker/compose.dev.yml)
DATABASE_URL=postgres://upchatz:upchatz@localhost:5433/upchatz
REDIS_URL=redis://localhost:6379/0

# Meta / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v24.0
META_WEBHOOK_VERIFY_TOKEN=
# Dotted path of the Graph client; the fake is handy for local UI work without Meta.
WHATSAPP_GRAPH_CLIENT=apps.whatsapp.client.graph.HttpGraphClient

# Fernet keys for stored customer tokens, comma-separated. The first key encrypts; all decrypt.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# Billing (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_IDS={}
# Seconds before a Razorpay API call times out.
RAZORPAY_TIMEOUT=20
BILLING_SELLER_LEGAL_NAME=
BILLING_SELLER_GSTIN=
BILLING_SELLER_STATE_CODE=
BILLING_SELLER_ADDRESS=
BILLING_SAC_CODE=998314
BILLING_GST_RATE_PERCENT=18

# Commerce (sell on WhatsApp)
# Public URL of this API (per-seller Razorpay webhook URLs) and of product images (Meta fetches
# catalog images, so use a public HTTPS bucket/CDN in production; empty = API host MEDIA_URL).
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_MEDIA_BASE_URL=
PAYMENT_LINK_EXPIRY_MINUTES=30
ORDER_CHECKOUT_TTL_MINUTES=35
# UpChatz's own alerts number (UpChatz WABA) that messages sellers about orders. Empty disables alerts.
PLATFORM_WA_WABA_ID=
PLATFORM_WA_PHONE_NUMBER_ID=
PLATFORM_WA_DISPLAY_PHONE_NUMBER=
PLATFORM_WA_ACCESS_TOKEN=

# Email
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Error tracking
SENTRY_DSN=

# Messaging, realtime and media
CAMPAIGN_BATCH_SIZE=100
WS_TICKET_TTL=30
WS_ALLOWED_ORIGINS=http://localhost:5173
MEDIA_ROOT=
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
# Cost estimates only (INR per message); Meta bills businesses directly
WHATSAPP_RATE_MARKETING_INR=0.7846
WHATSAPP_RATE_UTILITY_INR=0.1150
WHATSAPP_RATE_AUTHENTICATION_INR=0.1150
WHATSAPP_RATE_SERVICE_INR=0
