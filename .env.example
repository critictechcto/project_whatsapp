# Copy to .env and fill in. Never commit real values.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database / cache
DATABASE_URL=postgres://user:password@localhost:5432/project_whatsapp
REDIS_URL=redis://localhost:6379/0

# Meta / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=

# Encryption key for stored customer access tokens (Fernet)
TOKEN_ENCRYPTION_KEY=

# Billing (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Error tracking
SENTRY_DSN=
